# Backend API base URL (same backend + database as the customer website)
VITE_API_URL=http://localhost:5000/api
# Customer website URL, used by "View website" links
VITE_SITE_URL=http://localhost:5173
# Dev only. Production builds always call same-origin /api, which vercel.json proxies to https://maiwadi-ecom.onrender.com
# (keeps the auth cookie first-party), so VITE_API_URL is ignored on Vercel.
