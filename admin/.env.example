# Backend API base URL (same backend + database as the customer website)
VITE_API_URL=http://localhost:5000/api
# Customer website URL, used by "View website" links
VITE_SITE_URL=http://localhost:5173
# Production (Vercel): VITE_API_URL=/api — vercel.json proxies /api to https://maiwadi-ecom.onrender.com so auth cookies stay first-party.
# Must end in /api (requests are built as <VITE_API_URL>/products etc.).
