# Copy to .env and fill in. Never put real values in this file — it is committed to Git.
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# Database name inside the cluster (used when the URI has no /dbname path)
MONGODB_DB=maiwadi
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Frontend + admin origins allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173,http://localhost:5174
# lax = apps reach the API same-site (localhost dev, or Vercel /api rewrite). none = cross-site API calls (requires HTTPS)
COOKIE_SAMESITE=lax

# Initial admin (used by `npm run seed`; password >= 10 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=MAI WADI Admin

# Cloudinary (required in production; without it uploads are saved to ./uploads for local dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional; online payment is hidden when unset — Cash on Delivery only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
