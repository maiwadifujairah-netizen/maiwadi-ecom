{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://maiwadi-ecom.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://maiwadi-ecom.onrender.com/uploads/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://maiwadi-ecom.onrender.com/static/:path*"
    },
    {
      "source": "/((?!api/|uploads/|static/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
