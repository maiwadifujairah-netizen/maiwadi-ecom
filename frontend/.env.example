# Backend API base URL (same backend + database as the admin dashboard)
VITE_API_URL=http://localhost:5000/api
# Dev only. Production builds always call same-origin /api, which vercel.json proxies to https://maiwadi-ecom.onrender.com
# (keeps the auth cookie first-party), so VITE_API_URL is ignored on Vercel.
# Google Sign-In Web OAuth client ID (public, same as backend GOOGLE_CLIENT_ID). Unset = Google button hidden.
# Set it in Vercel → Project → Settings → Environment Variables, then redeploy (Vite bakes it in at build time).
VITE_GOOGLE_CLIENT_ID=
